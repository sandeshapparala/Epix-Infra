# Browser Firebase settings (the web app registration, never an Admin key).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=epix-infra
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=epix-infra.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server: local file outside the checkout OR the email/private-key pair below.
FIREBASE_ADMIN_PROJECT_ID=epix-infra
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=epix-infra.firebasestorage.app

# Private previews and PDFs use Cloud Storage. Legacy Firestore references remain readable.
THEATER_MEDIA_BACKEND=storage
