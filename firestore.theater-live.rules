// Scoped workspace protection; preserves the currently deployed legacy website rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collectionId}/{document=**} {
      allow read, write: if !collectionId.matches('theater.*');
    }
    // Allow admin users to read and write to 'contact' and 'feedback' collections
    match /contact/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    match /feedback/{docId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}